{
  "name": "stultus-rhino-gateway",
  "private": true,
  "version": "0.1.1",
  "description": "Gateway для плагина Stultus Rhino: принимает окна Rhino 8 по WebSocket, раздаёт им интерфейс и Python-скрипты инструментов, отдаёт инструменты Claude Code и Codex как MCP-сервер",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.268",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": "^0.154.0",
    "sharp": "^0.34.5",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.0"
  }
}
